[Unit]
Description=Capital nightly data ingestion (LSEG EOD, market data, derived tables, S3 backup)
Wants=network-online.target
After=network-online.target
OnFailure=capital-alert.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/capital-dashboard
EnvironmentFile=/opt/capital-dashboard/.env
ExecStart=/opt/capital-dashboard/.venv/bin/capital-ingest nightly
TimeoutStartSec=2h
Nice=10
