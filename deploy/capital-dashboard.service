[Unit]
Description=Capital Team Streamlit Dashboard
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/capital-dashboard
EnvironmentFile=/opt/capital-dashboard/.env
ExecStart=/opt/capital-dashboard/.venv/bin/streamlit run app/Home.py \
  --server.port 8501 \
  --server.address 127.0.0.1 \
  --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
