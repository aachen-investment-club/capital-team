# ─────────────────────────────────────────────────────────────────────────────
# Portfolio Analytics Dashboard — environment configuration
#
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
# settings.py (src/capital/settings.py) is the only reader of these variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── S3 / AWS ──────────────────────────────────────────────────────────────────
# Portfolio JSONs (written by the external IBKR Lambda) + DuckDB backups.
# Leave S3_BUCKET blank to run fully locally against ./data/.
S3_BUCKET=aic-fund-public-data
AWS_REGION=eu-central-1

# Explicit credentials (local dev). Leave blank on EC2 with an IAM instance
# profile — boto3/DuckDB resolve it automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=         # only for temporary/STS credentials

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Basket/theme assignments per symbol (read-only). Blank = category fallback.
DDB_TABLE=fund-baskets

# ── Local DuckDB store + caches ───────────────────────────────────────────────
# Defaults: ./data/market.duckdb and ./data/cache — override on the server.
#CAPITAL_DB=/opt/capital-dashboard/data/market.duckdb
#CAPITAL_CACHE=/opt/capital-dashboard/data/cache

# ── LSEG Data Platform (nightly capital-ingest eod/fund) ─────────────────────
# Session type: "platform" (server — RDP, headless) or "desktop" (a workstation
# with LSEG Workspace running; app key only, ignores username/password).
LSEG_SESSION_TYPE=platform
LSEG_APP_KEY=
LSEG_USERNAME=            # RDP username (email) — platform session only
LSEG_PASSWORD=            # RDP password         — platform session only
LOOKBACK_DAYS=5           # nightly fetch window; covers weekends + holidays

# ── FRED ──────────────────────────────────────────────────────────────────────
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, FRED history is capped at ~3 years by the anonymous endpoint.
FRED_API_KEY=

# ── Ops ───────────────────────────────────────────────────────────────────────
# healthchecks.io ping URL — alerts on failed AND missed nightly ingests.
HEALTHCHECK_URL=
