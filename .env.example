# ─────────────────────────────────────────────────────────────────────────────
# Portfolio Analytics Dashboard — environment configuration
#
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
# Two modes:
#   LOCAL  Leave S3_BUCKET empty. App reads from ./data/raw and ./data/derived.
#   S3     Set S3_BUCKET. App reads directly from S3 via DuckDB.
#          AWS credentials must be available (SSO login, IAM role, or env vars).
# ─────────────────────────────────────────────────────────────────────────────

# ── S3 ────────────────────────────────────────────────────────────────────────
# Leave S3_BUCKET blank to run fully locally against ./data/
S3_BUCKET=aic-fund-public-data

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1

# Explicit credentials (local dev or EC2 with env vars).
# Leave blank on EC2 if using an IAM role — boto3 resolves it automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=         # only needed for temporary/STS credentials

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Basket/theme assignments per symbol. Read-only from the dashboard.
# Leave blank to fall back to category from instrument_metadata.parquet.
DDB_TABLE=fund-baskets

# ── LSEG Data Library (local scripts) ────────────────────────────────────────
# Used by scripts/ingest_eod.py and scripts/lookup_rics.py.
# Reads credentials from lseg-data.config.json (desktop/Workspace session).
LSEG_APP_KEY=
LSEG_SESSION_TYPE=desktop   # desktop (Eikon/Workspace) for local scripts

# ── Lambda env vars (set in AWS Lambda console, not here) ────────────────────
#
# fund-data-ingestion  (nightly — IBKR Flex → nav_history.json + DynamoDB)
#   IBKR_FLEX_TOKEN=
#   IBKR_QUERY_ID=
#
# fund-eod-ingestion  (nightly — LSEG → EOD Parquet on S3)
#   S3_BUCKET=aic-fund-public-data
#   AWS_REGION=eu-central-1
#   LSEG_APP_KEY=
#   LSEG_USERNAME=            ← RDP username (email)
#   LSEG_PASSWORD=            ← RDP password
#   LOOKBACK_DAYS=5           ← days to fetch; covers weekends + holidays
