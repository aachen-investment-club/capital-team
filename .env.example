# ─────────────────────────────────────────────────────────────────────────────
# Portfolio Analytics Dashboard — environment configuration
#
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.
#
# Two modes:
#   LOCAL  Leave S3_BUCKET empty. App reads from ./data/raw and ./data/derived.
#   S3     Set S3_BUCKET. App reads directly from S3 via DuckDB.
#          AWS credentials must be available (SSO login, IAM role, or env vars).
# ─────────────────────────────────────────────────────────────────────────────

# ── S3 ────────────────────────────────────────────────────────────────────────
# Leave S3_BUCKET blank to run fully locally against ./data/
S3_BUCKET=aic-fund-public-data

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1

# Explicit credentials (local dev or EC2 with env vars).
# Leave blank on EC2 if using an IAM role — boto3 resolves it automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=         # only needed for temporary/STS credentials

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Basket/theme assignments per symbol. Read-only from the dashboard.
# Leave blank to fall back to category from instrument_metadata.parquet.
DDB_TABLE=fund-baskets

# ── LSEG Data Library ─────────────────────────────────────────────────────────
# Used by scripts/ingest_eod.py to fetch EOD price history.
# Full credentials go in lseg-data.config.json (see LSEG developer portal).
# LSEG_APP_KEY must match the app-key in that config file.
LSEG_APP_KEY=
LSEG_SESSION_TYPE=platform   # platform (RDP) or desktop (Eikon/Workspace)

# ── Lambda env vars (set in AWS Lambda console, not here) ────────────────────
#
# fund-data-ingestion  (website — IBKR Flex + nav_history.json + DynamoDB)
#   IBKR_FLEX_TOKEN=<token from IBKR Account Management → Settings → Flex Web Service>
#   IBKR_QUERY_ID=<daily query ID from IBKR Flex Queries>
#
# fund-market-data  (dashboard — yFinance EOD prices → S3 partitions)
#   S3_BUCKET=aic-fund-public-data
#   AWS_REGION=eu-central-1
#   DDB_TABLE=fund-data          ← reads POSITIONS written by fund-data-ingestion
